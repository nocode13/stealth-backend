// Prisma schema — платформа продажи цветов (marketplace-ready)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // управляет справочником и продавцами
  SELLER // управляет своими листингами
  CUSTOMER // покупатель (мобилка)
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Статус ревью для категорий/позиций каталога, предложенных продавцом.
// SUPER_ADMIN создаёт сразу APPROVED; SELLER — уходит в PENDING до апрува.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Фото и видео позиции каталога лежат в ОДНОЙ таблице (catalog_item_media) и
// различаются только этим полем: галерея у них общая, порядок сквозной.
enum MediaType {
  IMAGE
  VIDEO
}

// PROCESSING бывает только у видео: строка появляется сразу после загрузки, а mp4
// и обложка досоздаются фоновым воркером (MediaProcessingService). Фото готовы
// сразу, поэтому дефолт — READY.
enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

// Жизненный цикл заказа. Переходы валидируются в OrdersService.ALLOWED_TRANSITIONS —
// эта же карта строит кнопки в кабинете продавца в боте, чтобы список не разъезжался.
enum OrderStatus {
  NEW // создан, продавец ещё не подтвердил
  CONFIRMED // продавец принял
  ASSEMBLING // собирается
  DELIVERING // передан курьеру, едет
  ARRIVED // курьер на месте — покупателю уходит пуш «выходите, заказ у двери»
  DELIVERED // доставлен (терминальный)
  CANCELLED // отменён (терминальный)
}

// Статус чекаута целиком. Повторяет OrderStatus плюс PARTIALLY_DELIVERED —
// он возможен только у группы (часть продавцов довезла, часть ещё нет) и
// поэтому в OrderStatus его нет.
// ⚠️ Значение НЕ выставляется руками: deriveGroupStatus() считает его из статусов
// заказов группы. Второй карты переходов не заводим — источник правды один,
// ALLOWED_TRANSITIONS у Order.
enum OrderGroupStatus {
  NEW
  CONFIRMED
  ASSEMBLING
  DELIVERING
  ARRIVED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

// Пока единственный способ оплаты. Payme/Click добавляются значениями этого енама —
// отдельная однострочная миграция, схема заказа при этом не меняется.
enum PaymentMethod {
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

// Тип события в ленте уведомлений мобилки. Гранулярность намеренно грубая:
// конкретный статус лежит в Notification.payload.status, а не в отдельном
// значении енама. Иначе тут появилась бы вторая копия OrderStatus, и она бы
// разъехалась с ALLOWED_TRANSITIONS при добавлении статуса — ровно то, что
// AGENTS.md запрещает делать со списком статусов.
enum NotificationType {
  ORDER_STATUS_CHANGED // legacy: событие по одному Order, больше не эмитится
  ORDER_GROUP_STATUS_CHANGED // статус ГРУППЫ (всего чекаута) изменился
}

// Зачем открывали бота по диплинку. Один вариант сегодня (продавец привязывает Telegram),
// но модель осталась в форме enum+таблица на случай следующего bot-link флоу — раньше тут
// был ещё DELIVERY_LOCATION (адрес доставки покупателя), выпилен в пользу пикера карты.
enum BotSessionPurpose {
  SELLER_LINK // продавец привязывает свой Telegram к аккаунту админки
}

model User {
  id              String         @id @default(cuid())
  // telegramId — якорь личности покупателя: адрес в ОСНОВНОМ боте и вход в мобилку.
  telegramId      String?        @unique
  // staffTelegramId — адрес кабинета в боте ПРОДАВЦА. Колонки разные намеренно:
  // у продавца и покупателя может быть один и тот же Telegram, это две разные
  // учётки, и каждый бот ищет своего юзера по своей колонке.
  staffTelegramId String?        @unique
  // phone/email/name — опциональные профильные поля, юзер дозаполняет их сам.
  // В профиле они так и остаются опциональными, но checkout требует телефон и имя:
  // они уходят в снапшот заказа (Order.contactPhone/contactName), а телефон,
  // если его ещё не было, дописывается сюда.
  phone           String?        @unique
  email           String?        @unique
  // Адрес подтверждён кодом с почты. NULL — вписан в профиль до перехода на
  // email-вход (легаси) и как якорь входа не считается доверенным: verify по
  // такому адресу пускает и заодно проставляет emailVerifiedAt.
  emailVerifiedAt DateTime?
  name            String?
  // passwordHash опционален: он есть только у админов (вход по паролю в админку).
  passwordHash    String?
  role            Role           @default(CUSTOMER)
  // Продавец, к которому привязан пользователь (для роли SELLER). Их может быть
  // несколько на одного продавца — это команда (Seller.members), и уведомления о
  // заказах уходят всем её участникам с привязанным staffTelegramId.
  sellerId        String?
  seller          Seller?        @relation("SellerMembers", fields: [sellerId], references: [id], onDelete: SetNull)
  // Продавец, которым владеет пользователь (owner). Обратная сторона Seller.owner.
  ownedSeller     Seller?        @relation("SellerOwner")
  refreshTokens   RefreshToken[]
  cartItems       CartItem[]
  orders          Order[]
  orderGroups     OrderGroup[]
  savedAddresses  SavedAddress[]
  notifications   Notification[]
  pushTokens      PushToken[]
  // deletedAt — юзер удалил аккаунт из мобилки. Строку не удаляем: Order.userId
  // стоит Restrict, а заказы обязаны пережить удаление ради отчётности (их
  // персональный снапшот при этом затирается). Всё остальное — профиль, адреса,
  // корзина, уведомления, push-токены, сессии — чистится по-настоящему.
  // Заполненный deletedAt = вход запрещён, а телефон/email/telegramId обнулены,
  // так что повторная регистрация создаст НОВУЮ учётку.
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([createdAt])
  // Команда продавца: список сотрудников в админке и веер уведомлений о заказах.
  @@index([sellerId])
  @@map("users")
}

// Короткоживущая сессия входа через Telegram-бота (deeplink + polling).
// Мобилка создаёт строку и открывает t.me/<bot>?start=<nonce>; бот на /start
// проставляет telegramId/userId; мобилка поллит и забирает токены ровно один раз.
// Токены здесь НЕ хранятся — при консьюме выпускается свежая пара (issueTokens).
model TelegramAuthSession {
  id         String    @id @default(cuid())
  nonce      String    @unique
  telegramId String? // проставляется ботом на /start
  userId     String? // юзер, найденный/созданный по telegramId
  consumedAt DateTime? // токены уже забраны — повторно не выдаём
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@map("telegram_auth_sessions")
}

// Вход по коду на почту: код генерится сразу при создании сессии и уходит в
// письмо (Resend) — в отличие от бывшего PhoneAuthSession, промежуточного шага
// подтверждения тут нет, поэтому ни codeHash?, ни mismatch, ни поллинга не нужно.
model EmailAuthSession {
  id         String    @id @default(cuid())
  nonce      String    @unique
  email      String // нормализован: trim + lowercase
  codeHash   String // sha256(OTP) — код уже отправлен на почту
  userId     String? // привязка к текущему юзеру (link-флоу) либо тестовый аккаунт
  attempts   Int       @default(0) // неверные вводы кода, на 5-м сессия гаснет
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("email_auth_sessions")
}

// Короткоживущая сессия «сходить в бота и вернуться» — та же механика, что у
// TelegramAuthSession (nonce в диплинке + поллинг), но для уже известного пользователя:
// userId берётся из текущей авторизации, а не создаётся ботом.
// TelegramAuthSession намеренно оставлена отдельной моделью: она выдаёт токены и
// консьюмится иначе, объединять их значило бы усложнить вход ради экономии таблицы.
model BotLinkSession {
  id      String            @id @default(cuid())
  nonce   String            @unique
  purpose BotSessionPurpose
  userId  String

  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("bot_link_sessions")
}

// Хранит хэш активного refresh-токена мобильной сессии (ротация при обновлении).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // sha256 от refresh-токена
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Seller {
  id           String        @id @default(cuid())
  name         String
  description  String?
  bannerUrl    String?
  status       SellerStatus  @default(ACTIVE)
  ownerUserId  String        @unique
  owner        User          @relation("SellerOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members      User[]        @relation("SellerMembers")
  listings     Listing[]
  categories   Category[]
  catalogItems CatalogItem[]
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("sellers")
}

// Категории каталога: master (sellerId = null, создаёт SUPER_ADMIN, сразу APPROVED)
// и кастомные, предложенные продавцом (sellerId заполнен, уходят в PENDING до апрува
// SUPER_ADMIN'ом и видны/доступны для использования только этому продавцу).
model Category {
  id           String        @id @default(cuid())
  nameRu       String
  nameUz       String?
  nameEn       String?
  nameKaa      String?
  sellerId     String?
  seller       Seller?       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status       ReviewStatus  @default(APPROVED)
  catalogItems CatalogItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("categories")
}

// Справочник цветов — master-список (sellerId = null, создаёт SUPER_ADMIN) плюс
// кастомные позиции, предложенные продавцом (тот же паттерн ревью, что и Category).
model CatalogItem {
  id          String             @id @default(cuid())
  name        String
  // Категория необязательна: позицию можно завести до того, как категория придумана
  // или одобрена, и снять её позже (PATCH с categoryId: null).
  categoryId  String?
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description String?
  media       CatalogItemMedia[]
  unit        String             @default("шт") // единица измерения: шт, букет, упаковка...
  sellerId    String?
  seller      Seller?            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status      ReviewStatus       @default(APPROVED)
  listings    Listing[]
  /// Позиция из вайтлиста бесплатной доставки. Ставит только SUPER_ADMIN: флаг стоит
  /// платформе денег. Корзина едет бесплатно, только если ВСЕ её позиции с этим флагом.
  freeDelivery Boolean           @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@map("catalog")
}

/// Настройки платформы — ровно одна строка (id = "default"). Отдельная модель, а не env:
/// тариф меняет супер-админ из админки, без редеплоя.
model PlatformSettings {
  id String @id @default("default")

  /// Стоимость доставки за чекаут, в тийинах. 0 = доставка бесплатная всегда.
  deliveryFee Int @default(0)
  /// Сумма товаров, с которой доставка бесплатна. null = бесплатной доставки нет.
  freeDeliveryThreshold Int?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// Медиа позиции каталога — фото И видео в одной таблице, много на одну позицию.
// sortOrder — явный сквозной порядок галереи (first = обложка/превью), меняется
// кнопками вверх/вниз в админке.
//
// У видео url на время обработки указывает на загруженный оригинал, а после
// транскода перезаписывается ссылкой на mp4; posterUrl — webp-кадр, обложка.
// Публичная витрина отдаёт только status: READY.
model CatalogItemMedia {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  type          MediaType   @default(IMAGE)
  status        MediaStatus @default(READY)
  url           String
  posterUrl     String? // только у видео
  sortOrder     Int
  createdAt     DateTime    @default(now())

  @@index([catalogItemId])
  @@index([status])
  @@map("catalog_item_media")
}

// Предложение продавца поверх позиции справочника + инвентарь (остаток).
model Listing {
  id            String        @id @default(cuid())
  sellerId      String
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem   @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  price         Int
  stock         Int           @default(0)
  status        ListingStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([sellerId, catalogItemId])
  @@index([status])
  @@index([catalogItemId])
  @@index([createdAt])
  @@map("listings")
}

// Позиция в корзине покупателя. Отдельной обёртки Cart нет — у пользователя
// неявно одна корзина, как RefreshToken висит прямо на User без "Session".
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("cart_items")
}

// Группа заказов одного чекаута — общие данные оформления (контакты, адрес, оплата,
// итог) живут здесь ОДИН раз, а не копией в каждом Order. Один checkout с товарами
// разных продавцов даёт одну OrderGroup и по одному Order на продавца.
model OrderGroup {
  id          String @id @default(cuid())
  // Человекочитаемый номер чекаута — как Order.orderNumber, но на группу.
  groupNumber Int    @unique @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status OrderGroupStatus @default(NEW)

  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)

  // Снапшот на момент оформления — ровно то, что раньше дублировалось в каждом Order.
  contactName  String
  contactPhone String

  deliveryAddress String
  deliveryComment String?
  deliveryLat     Float?
  deliveryLng     Float?
  savedAddressId  String?
  savedAddress    SavedAddress? @relation(fields: [savedAddressId], references: [id], onDelete: SetNull)

  // Итог по всему чекауту — доставка платформенная и считается один раз здесь,
  // не на каждом Order (у него остаётся только itemsTotal, доля продавца).
  itemsTotal  Int
  deliveryFee Int @default(0)
  total       Int

  orders  Order[]
  history OrderGroupStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@map("order_groups")
}

// Заказ — всегда на ОДНОГО продавца: один checkout с товарами разных продавцов
// режется на несколько Order с общим groupId → OrderGroup. Отдельной модели Checkout
// нет по той же причине, что нет обёртки Cart над CartItem — сущность без собственных
// полей не нужна, а общие данные чекаута теперь и так живут в OrderGroup.
//
// Свои деньги — только itemsTotal (доля продавца), снапшот на момент оформления: цена
// листинга меняется, а заказ обязан остаться читаемым как есть. Доставка на Order не
// раскладывается — она платформенная и живёт целиком в OrderGroup.deliveryFee/total.
model Order {
  id          String @id @default(cuid())
  // Общий ключ заказов одного оформления (несколько продавцов = несколько Order).
  groupId     String
  group       OrderGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  // Человекочитаемый номер для поддержки и для поиска в боте.
  orderNumber Int    @unique @default(autoincrement())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  sellerId String
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  status OrderStatus @default(NEW)

  // Доставка — платформенная, считается один раз на чекаут (OrderGroup.deliveryFee/total).
  // Доля продавца — только itemsTotal, разложения доставки на заказ нет намеренно.
  itemsTotal Int

  // Задел под курьерскую систему: позже заменяется на courierId → модель Courier.
  courierName  String?
  courierPhone String?

  cancelReason String?

  items   OrderItem[]
  history OrderStatusHistory[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  deliveredAt DateTime?

  @@index([groupId])
  @@index([sellerId, status])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

// Позиция заказа — полный снапшот, а не только FK на листинг: цена и название меняются,
// листинг может уехать в ARCHIVED или быть удалён (тогда listingId станет null).
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  catalogItemName     String
  catalogItemImageUrl String?
  unit                String  @default("шт")

  price    Int
  quantity Int
  total    Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// Лог смен статуса: по нему строится таймлайн заказа в мобилке и в админке.
// changedByUserId пуст, когда статус проставила система (создание заказа).
model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status          OrderStatus
  comment         String?
  changedByUserId String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// Лог смен статуса ГРУППЫ — зеркало OrderStatusHistory, но пишется не при каждой
// смене статуса Order, а только когда production deriveGroupStatus() (order-status.ts)
// после неё даёт НОВОЕ значение (applyStatusTx в orders.service.ts). Иначе каскад по
// нескольким заказам группы за одну операцию (changeGroupStatus, cancelMyGroup) плодил
// бы по записи на каждый задетый заказ вместо одной осмысленной на реальный переход.
model OrderGroupStatusHistory {
  id      String     @id @default(cuid())
  groupId String
  group   OrderGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  status          OrderGroupStatus
  comment         String?
  changedByUserId String?

  createdAt DateTime @default(now())

  @@index([groupId])
  @@map("order_group_status_history")
}

// Адресная книга покупателя. Order на неё не полагается как на источник правды —
// у Order всегда свой снапшот (deliveryAddress/deliveryComment/deliveryLat/deliveryLng),
// эта модель только даёт переиспользовать адрес между заказами и подставлять его в checkout.
model SavedAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label   String? // "Дом" / "Работа" — необязательно, пользователь не всегда называет адрес
  address String
  comment String?
  lat     Float?
  lng     Float?

  orderGroups OrderGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_addresses")
}

// Лента уведомлений покупателя — источник правды для in-app нотификаций.
//
// Зачем таблица, а не только push: мобилка работает как Telegram Mini App, где
// Web Push недоступен, а сообщение бота приходит в чат ПОД Mini App'ом и юзер его
// не видит, пока не свернёт приложение. Клиент поллит /mobile/notifications и
// узнаёт об изменениях, не выходя из приложения. Когда появится нативка, push
// станет ещё одним каналом доставки поверх этой же таблицы, а не заменой ей.
model Notification {
  id String @id @default(cuid())

  // Курсор ленты. Тот же приём, что Order.orderNumber: cuid как PK + отдельный
  // монотонный autoincrement для порядка.
  //
  // ⚠️ Курсором НЕ может быть createdAt: now() в Postgres — это время начала
  // транзакции, а не оператора, поэтому все строки одной транзакции получают
  // одинаковую метку. Запрос `createdAt > cursor` вернул бы первую и навсегда
  // потерял остальные (а `>=` бесконечно дублировал бы последнюю).
  //
  // Int, а не BigInt: 2.1 млрд строк недостижимы, а BigInt не сериализуется в JSON.
  seq Int @unique @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  // Данные события, а не готовый текст. Тексты живут в коде клиента: положив сюда
  // отрендеренную строку, мы бы зашили язык в БД навсегда — а мультиязычность уже
  // заложена в Category (nameRu/nameUz/nameEn/nameKaa).
  // Для ORDER_GROUP_STATUS_CHANGED: { groupId, groupNumber, status } —
  // status здесь OrderGroupStatus, то есть бывает и PARTIALLY_DELIVERED.
  // У строк legacy-типа ORDER_STATUS_CHANGED лежит { orderId, orderNumber, status }:
  // они остаются в ленте как есть, поэтому бутстрап-страница бывает смешанной.
  payload Json

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Покрывает и поллинг (userId + seq > cursor), и подсчёт непрочитанных.
  @@index([userId, seq])
  @@map("notifications")
}

// Push-токен Expo (ExponentPushToken[...]) конкретной установки приложения.
// Второй канал доставки поверх той же ленты Notification: она остаётся источником
// правды (и единственным каналом в Mini App/вебе, где пушей нет), push лишь
// достаёт юзера, когда приложение закрыто.
model PushToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // unique по самому токену, а не по паре (userId, token): токен принадлежит
  // УСТАНОВКЕ, а не человеку. Если на одном устройстве вошёл другой юзер, строка
  // должна переехать к нему (upsert перезаписывает userId), иначе пуши продолжат
  // уходить предыдущему владельцу аккаунта.
  token    String @unique
  platform String // 'android' | 'ios'

  // Обновляется при каждой перерегистрации — по нему видно мёртвые установки,
  // если их не успел вычистить DeviceNotRegistered из receipts.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("push_tokens")
}
