# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:19006
# Публичный адрес админки: из него бот строит ссылку «Открыть в админке».
ADMIN_URL=http://localhost:5173

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://stealth:stealth@localhost:5432/stealth?schema=public"

# JWT (mobile)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Session (admin, httpOnly cookie)
SESSION_SECRET=change-me-session-secret

# Пароль супер-админа из сида. На проде задать сильный, локально можно не ставить.
SEED_ADMIN_PASSWORD=

# S3-совместимое хранилище фото каталога (локально — MinIO из docker-compose,
# на проде — Cloudflare R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com,
# S3_REGION=auto, S3_PUBLIC_URL=публичный домен бакета (pub-xxx.r2.dev или свой)).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=catalog
S3_ACCESS_KEY=stealth
S3_SECRET_KEY=stealth123
# Указывает на КОНКРЕТНЫЙ бакет — имя бакета входит в значение (для MinIO это
# endpoint + /catalog). Код склеивает ссылку как ${S3_PUBLIC_URL}/${key}.
S3_PUBLIC_URL=http://localhost:9000/catalog

# Redis — кеш публичной витрины мобилки (локально — из docker-compose).
# Пусто → кеш выключен, витрина читается прямо из БД. На Railway задать
# REDIS_URL=${{Redis.REDIS_URL}} (приватный URL сервиса, не публичный).
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# Push-уведомления покупателю (Expo Push Service). Токен нужен, только если в
# кабинете Expo включена «Enhanced Security for Push Notifications»; пусто —
# отправка работает без него. Пуш заменяет Telegram-DM покупателю: см.
# OrderNotifier.statusChanged.
EXPO_ACCESS_TOKEN=

# Основной бот: вход покупателя в мобилку (nonce/Mini App/OTP) и уведомления ему же.
# Пусто → приложение поднимается, бот не стартует (warning в лог).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# false → long-polling (dev, без публичного URL). true → webhook по TELEGRAM_WEBHOOK_URL.
# Режим общий для обоих ботов; бот продавца слушает ${TELEGRAM_WEBHOOK_URL}/seller.
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# TTL сессии входа по nonce (deeplink t.me/<bot>?start=<nonce> + polling).
TG_AUTH_SESSION_TTL_SECONDS=180

# Бот продавца: кабинет заказов и уведомления продавцу. Отдельный бот, потому что
# один человек может быть и покупателем, и продавцом — это две разные учётки.
# Пусто → кабинет и уведомления продавцу не работают, остальное поднимается.
TELEGRAM_SELLER_BOT_TOKEN=
TELEGRAM_SELLER_BOT_USERNAME=
TELEGRAM_SELLER_WEBHOOK_SECRET=

# Вход по коду на почту (Resend). Пусто → приложение поднимается с warning,
# POST /mobile/auth/email/session отвечает 400. RESEND_FROM — адрес отправителя,
# например `Egen <noreply@egen.uz>`; домен обязан быть верифицирован в Resend —
# до верификации можно гонять на onboarding@resend.dev (письма уйдут только на
# свой адрес аккаунта Resend).
RESEND_API_KEY=
RESEND_FROM=
# TTL сессии входа по коду на почту.
EMAIL_AUTH_SESSION_TTL_SECONDS=600

# Тестовый аккаунт для проверки в Play Store: с этим адресом вход идёт мимо Resend,
# кодом служит вечный TEST_LOGIN_OTP. Работает, только если заданы ОБЕ переменные.
TEST_LOGIN_EMAIL=
TEST_LOGIN_OTP=
